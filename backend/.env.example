# =====================================================================
# NyayaAI Backend Configuration
# =====================================================================

# Application
APP_TITLE=NyayaAI Legal Assistant
APP_VERSION=1.0.0-phase1
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (JSON array or comma-separated)
# Example: ["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration
# Phase 1 default: SQLite (async)
DATABASE_URL=sqlite+aiosqlite:///nyayaai.db
# Production PostgreSQL migration:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/nyayaai

# AI Provider Configuration
# Supported: gemini | openai
AI_PROVIDER=gemini

# Google Gemini Configuration (Primary AI Provider)
# Obtain your API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Configuration (Alternative Provider Option)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Vector Store Configuration
# Supported: chromadb | pgvector
VECTOR_STORE=chromadb
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=nyayaai_provisions

# IndianKanoon API (Optional - Supplementary Search Only)
# Note: IndianKanoon content is always categorized as supplementary, never official
INDIAN_KANOON_API_KEY=
INDIAN_KANOON_BASE_URL=https://api.indiankanoon.org
INDIAN_KANOON_TIMEOUT=30

# Corpus Data Paths
SEED_CORPUS_PATH=data/seed_corpus.json
SEED_AUTHORITIES_PATH=data/seed_authorities.json

# Cache Settings
PROVISION_CACHE_TTL_SECONDS=86400
PROVISION_CACHE_MAX_SIZE=1000
